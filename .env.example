# Copy this file to .env and fill in your keys
# cp .env.example .env

# ── Weather ────────────────────────────────────────────────────────────────────
# OpenWeatherMap — https://openweathermap.org/api (free tier: 1000 calls/day)
# Without this, weather falls back to wttr.in (free, no key)
OPENWEATHER_API_KEY=

# ── Attractions ────────────────────────────────────────────────────────────────
# OpenTripMap — https://opentripmap.com/product (free tier available)
# Without this, attractions fall back to OpenStreetMap Overpass (free, no key)
OPENTRIPMAP_API_KEY=

# ── Currency ───────────────────────────────────────────────────────────────────
# ExchangeRate-API — https://www.exchangerate-api.com (free tier: 1500 calls/month)
# Without this, currency falls back to a hardcoded offline rate table
EXCHANGERATE_API_KEY=

# ── LLM (optional) ────────────────────────────────────────────────────────────
# Anthropic — https://console.anthropic.com
# Used by the planner (intent extraction) and responder (narrative generation)
# Without this, rule-based planner and structured fallback responder are used
ANTHROPIC_API_KEY=
